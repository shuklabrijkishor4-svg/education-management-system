# Copy this file to .env and fill in real values. Never commit the real .env file.

# The Web App URL you get after deploying google-apps-script/Code.gs (see README).
GAS_WEB_APP_URL=https://script.google.com/macros/s/AKfycbynJB5o1d9z9hjpNbacvllwJp7aJ0isDAxij5jfEboKaJduih3EmQXFiUnv76mQAcM/exec

# A shared secret sent as a header to the Apps Script Web App so random people
# can't call your sheet directly. Must match SHARED_SECRET in Code.gs.
GAS_SHARED_SECRET=change-this-to-a-long-random-string

# Session signing secret — must be long, random, and kept private.
SESSION_SECRET=change-this-to-a-long-random-string-too

# Origin of the static frontend, for CORS (use * only for local testing).
FRONTEND_ORIGIN=http://localhost:5500

# Port the Express server listens on.
PORT=4000

# Set to "production" when deployed behind HTTPS so cookies are marked Secure.
NODE_ENV=development
